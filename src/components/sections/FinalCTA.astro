---
import Button from "../ui/Button.astro"
import { DAFTAR_URL } from "../../data/site"
import Ribbons from "../islands/Ribbons.tsx"
---

<section id="cta" class="relative overflow-hidden bg-gradient-to-br from-teal via-teal-dark to-teal text-white py-28 md:py-36">
  <Ribbons
    colors={["#14A398", "#FBBF24", "#ffffff", "#14A398"]}
    baseThickness={16}
    speedMultiplier={0.5}
    maxAge={650}
    pointCount={32}
    enableFade={true}
    enableShaderEffect={true}
    effectAmplitude={1.4}
    client:visible
  />
  <div class="glow-orb w-[600px] h-[600px] bg-white/[0.06] top-[-200px] left-[-200px]" data-parallax="0.2"></div>
  <div class="glow-orb w-[400px] h-[400px] bg-amber/[0.08] bottom-[-120px] right-[-120px] animate-pulse-glow"></div>

  <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
    <div class="reveal mb-6"><span class="eyebrow eyebrow-dark">Mulai Sekarang</span></div>
    <h2 class="fluid-heading-lg mb-4 reveal">
      <span class="gradient-white">Siap Memulai Perjalanan Belajar yang Lebih Bermakna?</span>
    </h2>
    <p class="text-featured text-white/60 mb-12 reveal">
      Klaim Promo 1 Sesi Gratis Sekarang. <br>
      <i><small>Syarat & Ketentuan Berlaku</small></i>
    </p>
    <div class="reveal">
      <Button href={DAFTAR_URL} variant="accent" class="btn-sheen neon-amber">
        Daftar Sekarang
      </Button>
    </div>
  </div>
</section>
